      "id": "openrouter-spam-model",
      "name": "OpenRouter Spam Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [672, 480],
      "credentials": {
        "openRouterApi": {
          "id": "9Cpj8UNSpHEq0gYe",
