      "parameters": {
        "jsCode": "// Zendesk search does NOT support querying organizations by domain\n// (verified empirically: 'type:organization domain:...' always returns 0),\n// so we list all orgs (paginated) and match domain_names client-side.\nconst domain = ($('Prepare Data').first().json.emailDomain || '').toLowerCase();\nconst orgs = $input.all().flatMap(i => (i.json.organizations || []));\nconst match = domain ? orgs.find(o => (o.domain_names || []).some(d => d.toLowerCase() === domain)) : null;\nreturn [{ json: { matched: !!match, orgId: match ? match.id : null, orgName: match ? match.name : '', orgsScanned: orgs.length } }];"
      },
