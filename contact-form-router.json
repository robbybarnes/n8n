    {
      "parameters": {
        "jsCode": "// Fail open: if the classifier failed or returned garbage, treat as NOT spam\n// so a legitimate lead is never silently dropped.\nconst item = $input.first().json;\nlet spam = false;\nlet reason = 'classifier unavailable - failed open';\ntry {\n  const out = item.output || {};\n  spam = out.spam === true || String(out.spam).toLowerCase().trim() === 'true';\n  if (out.reason !== undefined) reason = String(out.reason);\n} catch (e) { /* fail open */ }\nreturn [{ json: { spam, reason } }];"
      },
      "id": "parse-spam-verdict",
      "name": "Parse Spam Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 304]
    },
    {
