      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-name",
              "name": "name",
              "value": "={{ (($json.body || {}).name || $json.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "assign-email",
              "name": "email",
              "value": "={{ (($json.body || {}).email || $json.email || '').toLowerCase().trim() }}",
              "type": "string"
            },
            {
              "id": "assign-company",
              "name": "company",
              "value": "={{ (($json.body || {}).company || $json.company || '').trim() }}",
              "type": "string"
            },
            {
              "id": "assign-phone",
              "name": "phone",
              "value": "={{ (() => { const raw = ($json.body || {}).phone || $json.phone || ''; const digits = raw.replace(/[^0-9]/g, ''); if (raw.startsWith('+') && digits.length >= 10) return '+' + digits; if (digits.length === 10) return '+1' + digits; if (digits.length === 11 && digits.startsWith('1')) return '+' + digits; return ''; })() }}",
              "type": "string"
            },
            {
              "id": "assign-message",
              "name": "message",
              "value": "={{ ($json.body || {}).message || $json.message || '' }}",
              "type": "string"
            },
            {
              "id": "assign-domain",
              "name": "emailDomain",
              "value": "={{ (($json.body || {}).email || $json.email || '').toLowerCase().trim().split('@')[1] || '' }}",
              "type": "string"
            },
            {
              "id": "assign-first",
              "name": "firstName",
              "value": "={{ (($json.body || {}).name || $json.name || '').trim().split(' ')[0] || '' }}",
              "type": "string"
            },
            {
              "id": "assign-last",
              "name": "lastName",
              "value": "={{ (($json.body || {}).name || $json.name || '').trim().split(' ').slice(1).join(' ') || '' }}",
              "type": "string"
            },
            {
              "id": "assign-valid-email",
              "name": "isValidEmail",
              "value": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test((($json.body || {}).email || $json.email || '').toLowerCase().trim()) }}",
              "type": "boolean"
            },
            {
              "id": "assign-free-email",
              "name": "isFreeEmail",
              "value": "={{ ['gmail.com','googlemail.com','yahoo.com','ymail.com','rocketmail.com','hotmail.com','outlook.com','live.com','msn.com','icloud.com','me.com','mac.com','aol.com','protonmail.com','proton.me','pm.me','gmx.com','gmx.net','zoho.com','mail.com','fastmail.com','hey.com','duck.com','comcast.net','att.net','verizon.net','sbcglobal.net','cox.net','charter.net','earthlink.net','q.com','centurylink.net'].includes((($json.body || {}).email || $json.email || '').toLowerCase().trim().split('@')[1] || '') }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
