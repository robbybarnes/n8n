    {
      "parameters": {
        "text": "=Name: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nPhone: {{ $json.phone }}\nMessage:\n{{ $json.message }}",
        "attributes": {
          "attributes": [
            {
              "name": "spam",
              "description": "MUST be exactly the lowercase string 'true' if the submission is spam, or 'false' if it is legitimate.",
              "required": true
            },
            {
              "name": "reason",
              "description": "A brief one-sentence explanation of why the submission was classified as spam or legitimate.",
              "required": true
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are a spam filter for the website contact form of 2Fifteen Tech, a managed IT services provider (MSP) in Utah. Classify each submission as spam or legitimate.\n\nSpam includes: unsolicited sales pitches and cold outreach (cleaning services, lead lists, attendee lists, SEO or marketing offers, link building, staffing or outsourcing pitches), mass-mailed templates, and anything with opt-out language like 'reply STOP' or 'REMOVE'.\n\nLegitimate includes: genuine inquiries about IT services or support, questions from existing or prospective clients, and vendor or partner inquiries that specifically reference 2Fifteen Tech or its services.\n\nWhen uncertain, prefer legitimate."
        }
      },
      "id": "classify-spam",
      "name": "Classify Spam",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [672, 304],
      "onError": "continueRegularOutput"
    },
    {
