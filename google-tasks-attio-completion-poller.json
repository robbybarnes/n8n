{
  "updatedAt": "2026-06-25T03:53:06.219Z",
  "createdAt": "2026-06-16T22:17:12.612Z",
  "id": "08LswD1ur94rQ9DM",
  "name": "Google Tasks \u2192 Attio Completion (Ed)",
  "description": "Polls Ed's Google Tasks every 3 min; for completed tasks tagged attio:{id}, marks the matching Attio task complete (only if still open). Idempotent.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "6d3ad686-9c60-4ae8-a642-bcee6d54302d",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "17ddf29f-2d58-4e0a-9a96-7e50a250331e",
      "name": "Compute Poll Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst overlapMs = 3 * 60 * 1000;\nconst now = new Date();\nlet updatedMin;\nif (sd.lastPoll) {\n  updatedMin = new Date(new Date(sd.lastPoll).getTime() - overlapMs).toISOString();\n} else {\n  updatedMin = new Date(now.getTime() - 2 * overlapMs).toISOString();\n}\nsd.lastPoll = now.toISOString();\nreturn [{ json: { updatedMin: updatedMin } }];"
      }
    },
    {
      "id": "663b8c03-12fe-4cd6-9b1b-69d6e0a7eb51",
      "name": "List Recently Updated Google Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://tasks.googleapis.com/tasks/v1/lists/@default/tasks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleTasksOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "showCompleted",
              "value": "true"
            },
            {
              "name": "showHidden",
              "value": "true"
            },
            {
              "name": "maxResults",
              "value": "100"
            },
            {
              "name": "updatedMin",
              "value": "={{ $json.updatedMin }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "googleTasksOAuth2Api": {
          "id": "8uTxivwZjrvcV6D0",
          "name": "Google Tasks Ed"
        }
      }
    },
    {
      "id": "ee689478-bd9d-46b6-b3d6-58e172570f00",
      "name": "Extract Completed Mapped Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const list = $input.first().json;\nconst tasks = list.items || [];\nconst re = /attio:([0-9a-fA-F-]{36})/;\nconst out = [];\nfor (const t of tasks) {\n  if (t.status !== 'completed') continue;\n  const m = (t.notes || '').match(re);\n  if (!m) continue;\n  out.push({ json: { attioTaskId: m[1], googleTaskId: t.id } });\n}\nreturn out;"
      }
    },
    {
      "id": "96d1cb5f-80ee-4aaf-ae80-aba4da6dbe05",
      "name": "Get Attio Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.attio.com/v2/tasks/{{ $json.attioTaskId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpBearerAuth": {
          "id": "Jzr3nzWWJ7MKia7t",
          "name": "Attio Bearer Auth account"
        }
      }
    },
    {
      "id": "6b662e9c-0cee-4b88-b8a7-e19b2af9315f",
      "name": "Still Open in Attio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.is_completed ? \"done\" : \"open\" }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "open"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b8ac6b5e-9a99-45b1-8805-3d1ffeca860d",
      "name": "Complete Attio Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.attio.com/v2/tasks/{{ $json.data.id.task_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"data\":{\"is_completed\":true}}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpBearerAuth": {
          "id": "Jzr3nzWWJ7MKia7t",
          "name": "Attio Bearer Auth account"
        }
      }
    },
    {
      "id": "5f44ae59-a32d-4821-befe-28a57aebf670",
      "name": "Sticky Note 5e6b51a4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -50,
        -50
      ],
      "parameters": {
        "content": "## Google Tasks -> Attio (completion sync, polling)\nGoogle Tasks has no webhooks, so we poll every 10 min. We read tasks updated since the last poll (with overlap, tracked in workflow static data), keep only completed ones tagged attio:{id}, then mark the matching Attio task complete - but only if it is still open (idempotent, so our own PATCH never loops back via Flow A actor filter).\n\nCredential: Ed Google Tasks (googleTasksOAuth2Api) + Attio Bearer Auth account.",
        "color": 4,
        "width": 960,
        "height": 200
      }
    }
  ],
  "connections": {
    "Compute Poll Window": {
      "main": [
        [
